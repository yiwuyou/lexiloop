{
  "semanticPairs": [
    {
      "words": ["propel", "impetus"],
      "sense": "推动：动作与推动力的对照",
      "note": "propel 是动词，指推进、推动某人或某物；impetus 是名词，指促使行动或进展的动力。一个侧重推动的动作，一个侧重推动力，句中不能直接互换。",
      "sources": [
        "https://www.merriam-webster.com/dictionary/propel",
        "https://www.merriam-webster.com/dictionary/impetus"
      ]
    },
    {
      "words": ["propel", "impulse"],
      "sense": "推动：动作与推动力的对照",
      "note": "propel 指向前推进、推动；impulse 在推动义中可指促成行动或运动的力，也常指一时的冲动。这里对照推动这一部分含义，不把冲动当作 propel 的词义，也不表示两词能直接替换。",
      "sources": [
        "https://www.merriam-webster.com/dictionary/propel",
        "https://www.merriam-webster.com/dictionary/impulse"
      ]
    },
    {
      "words": [
        "involve",
        "include"
      ],
      "sense": "包含某个部分（动词义）",
      "note": "include：把人或事物作为整体的一部分包括在内；involve：某事涉及、需要某个重要或必要的部分。二者部分义项接近，不能在所有句子中互换。",
      "sources": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/include",
        "https://www.oxfordlearnersdictionaries.com/definition/english/involve"
      ]
    },
    {
      "words": [
        "include",
        "contain"
      ],
      "sense": "包括、包含（动词义）",
      "note": "include：整体中包括某部分，常用于列举；contain：内部含有某物，也可指内容或成分。中文都可译为“包含”，侧重点不同。",
      "sources": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/include",
        "https://www.oxfordlearnersdictionaries.com/definition/english/contain"
      ]
    },
    {
      "words": [
        "include",
        "comprise"
      ],
      "sense": "包括组成部分（动词义）",
      "note": "include：列出整体中的一部分，不要求列全；comprise：整体由所列部分组成。不要把中文“包括”直接等同为所有用法相同。",
      "sources": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/include",
        "https://www.oxfordlearnersdictionaries.com/definition/english/comprise"
      ]
    },
    {
      "words": [
        "contain",
        "comprise"
      ],
      "sense": "整体包含部分（动词义）",
      "note": "contain：强调内部含有某物；comprise：强调构成整体的各个部分。只在“整体包含部分”这一义项对照。",
      "sources": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/contain",
        "https://www.oxfordlearnersdictionaries.com/definition/english/comprise"
      ]
    },
    {
      "words": [
        "involve",
        "contain"
      ],
      "sense": "包含某个部分（动词义）",
      "note": "involve：活动或情况涉及某个重要、必要的部分或结果；contain：内部含有某物。关联用于辨别“包含”的不同语境，不表示可以随意替换。",
      "sources": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/involve",
        "https://www.oxfordlearnersdictionaries.com/definition/english/contain"
      ]
    },
    {
      "words": [
        "involve",
        "require"
      ],
      "sense": "需要某个必要部分（动词义）",
      "note": "involve doing：做某事涉及或需要某项活动；require：需要某物，或要求某人做某事。involve 常接 doing；require 可用 require somebody to do，也可用 require doing 表示“需被……”。",
      "sources": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/involve",
        "https://www.oxfordlearnersdictionaries.com/definition/english/require"
      ]
    }
  ],

.tab-bar {
  position: fixed;
  z-index: 30;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  width: 100vw;
  max-width: 100vw;
  padding: 10rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #dce4dd;
  background: rgba(248, 250, 247, .97);
  box-sizing: border-box;
}

.tab-item {
  position: relative;
  display: flex;
  width: 0;
  min-width: 0;
  min-height: 88rpx;
  flex: 1 1 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #657169;
  font-size: 23rpx;
  line-height: 1.2;
}

.tab-item.is-active {
  color: #0f5c37;
  font-weight: 600;
}

.tab-item.is-active::before {
  position: absolute;
  top: 5rpx;
  width: 76rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #e2efe6;
  content: '';
}

.tab-item-hover {
  opacity: .65;
}

.tab-icon {
  position: relative;
  z-index: 1;
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 34rpx;
  color: inherit;
}

.tab-item > text {
  position: relative;
  z-index: 1;
}

.home-roof {
  position: absolute;
  top: 4rpx;
  left: 8rpx;
  width: 18rpx;
  height: 18rpx;
  transform: rotate(45deg);
  border-top: 3rpx solid currentColor;
  border-left: 3rpx solid currentColor;
  border-radius: 2rpx;
  box-sizing: border-box;
}

.home-body {
  position: absolute;
  right: 7rpx;
  bottom: 3rpx;
  left: 7rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 3rpx 3rpx;
  box-sizing: border-box;
}

.book-left,
.book-right {
  position: absolute;
  top: 4rpx;
  bottom: 3rpx;
  width: 15rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
}

.book-left {
  left: 3rpx;
  border-radius: 5rpx 1rpx 1rpx 4rpx;
}

.book-right {
  right: 3rpx;
  border-radius: 1rpx 5rpx 4rpx 1rpx;
}

.chart-bar {
  position: absolute;
  bottom: 3rpx;
  width: 7rpx;
  border: 3rpx solid currentColor;
  border-radius: 3rpx 3rpx 1rpx 1rpx;
  box-sizing: border-box;
}

.chart-bar-one {
  left: 3rpx;
  height: 14rpx;
}

.chart-bar-two {
  left: 14rpx;
  height: 27rpx;
}

.chart-bar-three {
  right: 3rpx;
  height: 21rpx;
}

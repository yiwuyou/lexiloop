.detail-page { padding: 24rpx 26rpx calc(160rpx + env(safe-area-inset-bottom)); background: var(--surface); min-height: 100vh; box-sizing: border-box; }
.detail-footer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 5; padding: 16rpx 26rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: var(--surface); }
.detail-back { width: 100%; min-height: 44px; }

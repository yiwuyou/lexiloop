<view class="page-shell">
  <view class="title">收藏例句 · {{count}} 句</view>
  <view class="hint">隐藏英文看中文背诵，或隐藏中文练习理解；点句子可显示答案。</view>
  <view class="controls">
    <button class="secondary-button" bindtap="toggleEnglish">{{hideEnglish ? '显示英文' : '隐藏英文'}}</button>
    <button class="secondary-button" bindtap="toggleChinese">{{hideChinese ? '显示中文' : '隐藏中文'}}</button>
  </view>
  <view class="card sentence-card" wx:for="{{entries}}" wx:key="sentence">
    <view data-index="{{index}}" bindtap="reveal">
      <text class="target" data-word="{{item.word}}" catchlongpress="copyWord">{{item.word}}</text>
      <text class="english">{{!hideEnglish || item.revealed ? item.sentence : '点击显示英文答案'}}</text>
      <text class="chinese">{{!hideChinese || item.revealed ? item.translation : '点击显示中文释义'}}</text>
    </view>
    <button class="remove" data-index="{{index}}" bindtap="remove">取消收藏</button>
  </view>
  <view class="hint" wx:if="{{!count}}">在学习卡片或例句练习中点击“☆ 收藏”，即可在这里集中背诵。</view>
  <button class="secondary-button" wx:if="{{count > entries.length}}" bindtap="more">继续显示</button>
</view>

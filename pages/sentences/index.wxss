.title { font-size: 40rpx; font-weight: 600; margin: 20rpx 0; }
.hint { color: #657169; font-size: 26rpx; line-height: 1.6; margin: 20rpx 0; }
.controls { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.controls button { flex: 1; }
.sentence-card { padding: 28rpx; margin-bottom: 24rpx; }
.target, .english, .chinese { display: block; }
.target { color: #246b49; font-size: 24rpx; }
.english { font-size: 32rpx; line-height: 1.6; margin: 16rpx 0; }
.chinese { font-size: 28rpx; line-height: 1.6; color: #657169; }
.remove { background: transparent; color: #657169; font-size: 24rpx; margin: 20rpx 0 0; padding: 8rpx 0; line-height: 1.5; text-align: right; }
.remove::after { border: 0; }

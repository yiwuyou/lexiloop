<view class="study-page {{completed ? 'is-completed' : ''}} {{!revealed && !isContext ? 'is-recall' : 'is-answer'}}">
  <block wx:if="{{!completed}}">
    <view class="study-head">
      <button class="head-button" bindtap="exitStudy">返回</button>
      <view class="counter">
        <text class="phase">{{phaseLabel}}</text>
        <text class="counter-value">{{currentInPhase}} / {{phaseTotal}}</text>
      </view>
      <button class="head-button" bindtap="exitStudy">退出</button>
    </view>
    <view class="study-progress"><view style="width: {{progress}}%"></view></view>
    <text class="practice-note" wx:if="{{isPractice}}">自由练习 · 原定复习时间不变</text>

    <view wx:if="{{waiting}}" class="card" style="padding:40rpx;margin-top:32rpx">
      <view>还有词需要巩固，暂未完成</view>
      <view class="muted" style="margin:24rpx 0">稍作休息，约 {{waitSeconds}} 秒后再回忆。也可以退出，稍后继续。</view>
      <button class="primary-button" bindtap="exitStudy">保存并稍后继续</button>
    </view>
    <view wx:if="{{!waiting && pendingCount && !isPractice}}" class="practice-note">已作答的词中，还有 {{pendingCount}} 词待巩固</view>
    <block wx:if="{{!waiting && !isContext}}">
      <scroll-view class="study-content" style="{{contentHeight ? 'flex: none; height: ' + contentHeight + 'px;' : ''}}" scroll-y="{{true}}" show-scrollbar="{{true}}" scroll-top="{{contentScrollTop}}">
      <view class="word-card card">
        <view class="word-meta">
          <text>{{word.sourceLabel}}</text>
          <text class="kind">{{phaseLabel}}</text>
        </view>
        <view class="word-main">
          <text class="word">{{word.word}}</text>
          <view class="pronunciation" wx:if="{{word.audio}}" bindtap="playPronunciation" role="button" aria-label="播放单词发音">
            <view class="audio-button">{{audioLoading ? '…' : '▶'}}</view>
            <text class="ipa">{{word.ipa || '播放发音'}}</text>
          </view>
          <text class="prompt" wx:if="{{!revealed}}">先在脑中说出主要含义</text>
          <view class="answer" wx:else>
            <block wx:if="{{word.enhanced}}">
              <view class="meaning-heading"><text class="meaning-meta">机构释义 · {{word.partOfSpeech}}</text><button class="weak-link {{isWeakMarked ? 'is-marked' : ''}}" bindtap="toggleWeak">{{isWeakMarked ? '✓ 已在易忘' : '＋ 加入易忘'}}</button></view>
              <text class="target-meaning">{{word.meaning}}</text>
              <view class="understanding-panel"><text class="understanding-label">理解</text><text class="understanding-text">{{word.core || word.meaning}}</text></view>
              <view class="memory-panel" wx:if="{{word.hasMemoryContent}}">
                <view class="memory-head"><text class="memory-label">关联记忆</text></view>
                <view class="memory-row" wx:if="{{word.breakdown}}"><text>拆记</text><view><text class="breakdown">{{word.breakdown}}</text><text class="memory-note">{{word.breakdownNote}}</text></view></view>
                <view class="memory-row" wx:if="{{word.associationHint}}"><text>{{word.associationLabel || '助记'}}</text><text>{{word.associationHint}}</text></view>
                <view class="memory-row" wx:if="{{word.contrast}}"><text>辨析</text><text>{{word.contrast}}</text></view>
                <view class="memory-row" wx:if="{{word.family}}"><text>词族</text><text>{{word.family}}</text></view>
                <view class="memory-row" wx:if="{{word.wordForms.length}}"><text>词形</text><text><text class="form-inline" wx:for="{{word.wordForms}}" wx:key="word">{{item.word}}（{{item.label}}） </text></text></view>
              </view>
            </block>
            <text class="meaning" wx:else>{{word.meaning}}</text>
            <view class="example-panel" wx:if="{{word.example}}">
              <text class="memory-label">例句 · 放进场景记</text>
              <text class="example-en">{{word.example}}</text>
              <text class="example-zh">{{word.translation}}</text>
            </view>
          </view>
        </view>
        <button class="primary-button recall-reveal" wx:if="{{!revealed}}" bindtap="revealAnswer">显示答案</button>
      </view>
      </scroll-view>

      <view class="rating-area" wx:if="{{revealed}}">
        <text class="rating-label">选择最符合刚才回忆的情况</text>
        <view class="rating-grid">
          <button class="rating again" data-grade="again" bindtap="rate"><view class="rating-copy"><text>没想起</text><text>无法说出正确含义</text></view><view class="rating-depth"></view></button>
          <button class="rating hard" data-grade="hard" bindtap="rate"><view class="rating-copy"><text>部分想起</text><text>只想起部分义项</text></view><view class="rating-depth"></view></button>
          <button class="rating good" data-grade="good" bindtap="rate"><view class="rating-copy"><text>主要义想起</text><text>能说出主要义项</text></view><view class="rating-depth"></view></button>
          <button class="rating easy" data-grade="easy" bindtap="rate"><view class="rating-copy"><text>秒答完整</text><text>快速说出全部义项</text></view><view class="rating-depth"></view></button>
        </view>
      </view>
    </block>

    <block wx:if="{{!waiting && isContext}}">
      <scroll-view class="study-content" scroll-y="{{true}}" show-scrollbar="{{true}}" scroll-top="{{contentScrollTop}}">
      <view class="context-card card">
        <view class="word-meta">
          <text>{{word.sourceLabel}}</text>
          <text class="kind">语境辨义</text>
        </view>
        <text class="context-word">{{word.word}}</text>
        <text class="sentence">{{question.sentence}}</text>
        <text class="context-prompt">这里的词义是：</text>
        <view class="choice-list">
          <button
            wx:for="{{question.choices}}"
            wx:key="*this"
            class="choice {{contextAnswered && index === question.answer ? 'is-correct' : ''}} {{contextAnswered && index === selectedChoice && index !== question.answer ? 'is-wrong' : ''}}"
            data-index="{{index}}"
            bindtap="chooseContext"
          >{{item}}</button>
        </view>
        <view class="context-result {{contextCorrect ? 'correct' : 'wrong'}}" wx:if="{{contextAnswered}}">
          <text class="result-title">{{contextCorrect ? '判断正确' : '这次选错了'}}</text>
          <text class="translation">{{question.translation}}</text>
          <text class="explanation">{{question.explanation}}</text>
        </view>
      </view>
      </scroll-view>
      <button class="primary-button next-button" wx:if="{{contextAnswered}}" bindtap="nextContext">继续</button>
    </block>
  </block>

  <block wx:else>
    <view class="complete-view">
      <view class="complete-check">✓</view>
      <view class="complete-title">{{isPractice ? '本轮复习完成' : '今天完成了'}}</view>
      <text class="complete-note">{{isPractice ? '这次练习已单独记录，今日任务和之后的复习安排保持不变。' : '所有作答均已保存在这部手机，下次出现时间也已安排。'}}</text>
      <view class="complete-grid" wx:if="{{isPractice}}">
        <view><text>{{sessionSummary.minutes}}</text><text>分钟</text></view>
        <view><text>{{sessionSummary.practiceDone}}</text><text>练习词数</text></view>
        <view><text>{{sessionSummary.remembered}}</text><text>想起主要义</text></view>
      </view>
      <view class="complete-grid" wx:else>
        <view><text>{{sessionSummary.minutes}}</text><text>分钟</text></view>
        <view><text>{{sessionSummary.newDone}}</text><text>新词</text></view>
        <view><text>{{sessionSummary.dueDone}}</text><text>复习</text></view>
      </view>
      <view class="context-summary" wx:if="{{sessionSummary.contextDone}}">语境辨义 {{sessionSummary.contextCorrect}} / {{sessionSummary.contextDone}}</view>
      <button class="primary-button" bindtap="exitStudy">返回首页</button>
    </view>
  </block>
</view>

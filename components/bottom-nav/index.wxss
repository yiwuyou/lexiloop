.bottom-nav {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  width: 100vw;
  max-width: 100vw;
  padding: 10rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--line);
  background: rgba(248, 250, 247, .96);
}

.nav-item {
  display: flex;
  width: 0;
  min-width: 0;
  min-height: 88rpx;
  flex: 1 1 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  background: transparent;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.25;
}

.nav-item-hover {
  opacity: .65;
}

.nav-item.is-active {
  color: var(--main-strong);
}

.nav-icon {
  min-height: 38rpx;
  font-size: 30rpx;
  font-weight: 500;
}

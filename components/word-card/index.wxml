      <view class="word-card card {{revealed ? 'is-answer' : 'is-recall'}}">
        <view class="word-meta">
          <text user-select="{{true}}">{{word.sourceLabel}}</text>
          <text user-select="{{true}}" class="kind">{{phaseLabel}}</text>
        </view>
        <view class="word-main">
          <view class="word-heading"><text user-select="{{true}}" class="word" data-word="{{word.word}}">{{word.word}}</text></view>
          <view class="pronunciation" wx:if="{{word.audio}}" bindtap="playPronunciation" role="button" aria-label="播放单词发音">
            <view class="audio-button">{{audioLoading ? '…' : '▶'}}</view>
            <text user-select="{{true}}" class="ipa">{{word.ipa || '播放发音'}}</text>
          </view>
          <text user-select="{{true}}" class="prompt" wx:if="{{!revealed}}">先在脑中说出主要含义</text>
          <view class="answer" wx:else>
            <block wx:if="{{word.enhanced}}">
              <view class="meaning-heading"><text user-select="{{true}}" class="meaning-meta" bindtap="showPartOfSpeech">机构释义 · {{word.shortPartOfSpeech}}</text><button class="weak-link {{isWeakMarked ? 'is-marked' : ''}}" bindtap="toggleWeak">{{isWeakMarked ? '✓ 易忘' : '＋ 易忘'}}</button></view>
              <text user-select="{{true}}" class="target-meaning">{{word.meaning}}</text>
              <view class="understanding-panel"><text user-select="{{true}}" class="understanding-label">理解</text><text user-select="{{true}}" class="understanding-text">{{word.core || word.meaning}}</text></view>
              <view class="memory-panel" wx:if="{{word.hasMemoryContent}}">
                <view class="memory-head"><text user-select="{{true}}" class="memory-label">关联记忆</text></view>
                <view class="memory-row" wx:if="{{word.breakdown}}"><text user-select="{{true}}">拆记</text><view><text user-select="{{true}}" class="breakdown">{{word.breakdown}}</text><text user-select="{{true}}" class="memory-note">{{word.breakdownNote}}</text></view></view>
                <view class="memory-row" wx:if="{{word.associationHint}}"><text user-select="{{true}}">钩子</text><text user-select="{{true}}">{{word.associationHint}}</text></view>
                <view class="memory-row" wx:if="{{word.contrast}}"><text user-select="{{true}}">辨析</text><text user-select="{{true}}">{{word.contrast}}</text></view>
                <view class="memory-row" wx:if="{{word.phrase}}"><text user-select="{{true}}">短语</text><text user-select="{{true}}">{{word.phrase}}</text></view>
                <view class="memory-row" wx:if="{{word.family}}"><text user-select="{{true}}">词族</text><text user-select="{{true}}">{{word.family}}</text></view>
              </view>
            </block>
            <text user-select="{{true}}" class="meaning" wx:else>{{word.meaning}}</text>
            <view class="example-panel" wx:if="{{word.example}}">
              <view class="sentence-heading"><text user-select="{{true}}" class="memory-label">阅读例句 · 原创</text><button class="sentence-save" bindtouchstart="sentenceTouchStart" bindtouchmove="sentenceTouchMove" bindtouchend="sentenceTouchEnd" bindtouchcancel="sentenceTouchCancel" catchtap="tapSentence">{{isSentenceSaved ? '★ 已收藏' : '☆ 收藏'}}</button></view>
              <text user-select="{{true}}" class="example-en">{{word.example}}</text>
              <text user-select="{{true}}" class="example-zh">{{word.translation}}</text>
            </view>
          </view>
        </view>
        <view class="recall-actions {{lookupAvailable ? 'with-lookup' : ''}}" wx:if="{{!revealed}}">
          <button class="primary-button recall-reveal" bindtap="revealAnswer">显示答案</button>
          <button class="lookup-action" wx:if="{{lookupAvailable}}" bindtap="openLookup" hover-class="lookup-pressed" aria-label="查词库">查词</button>
        </view>
      </view>
